// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

// Packed4 branch: bf16 -> f4E1M2x2 storage bits ratio is 16:8 (f4 x2 packed
// per byte).  Contract requires requiresRnd=true, requiresSat=false,
// requiresPart=true (Packed4), allowedRnd="RAFZC".  Lowering must therefore
// NOT emit sat attr, and part must be P0..P3.

module {
  func.func @vmi_to_vpto_truncf_bf16_to_f4e1m2x2(
      %wide: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<deinterleaved = 4>>)
      -> !pto.vreg<256x!pto.f4E1M2x2> {
    %packed = pto.vmi.vcvt %wide {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<deinterleaved = 4>>
        -> !pto.vmi.vreg<128x!pto.f4E1M2x2, #pto.vmi.layout<contiguous>>
    %p = "pto.vmi.unpack"(%packed)
        : (!pto.vmi.vreg<128x!pto.f4E1M2x2, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<256x!pto.f4E1M2x2>
    return %p : !pto.vreg<256x!pto.f4E1M2x2>
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_truncf_bf16_to_f4e1m2x2(
// CHECK: pto.vcvt
// CHECK-SAME: part = "P0"
// CHECK-SAME: rnd = "R"
// CHECK-NOT: sat
// CHECK: pto.vcvt
// CHECK-SAME: part = "P1"
// CHECK-SAME: rnd = "R"
// CHECK: pto.vcvt
// CHECK-SAME: part = "P2"
// CHECK-SAME: rnd = "R"
// CHECK: pto.vcvt
// CHECK-SAME: part = "P3"
// CHECK-SAME: rnd = "R"
// CHECK: pto.vor
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
