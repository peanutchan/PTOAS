// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto 2>&1 | FileCheck %s

// preferred_expand=e2b with G=4 is illegal (E2B table requires G=8).

module {
  func.func @prefer_e2b_bad_g(
      %src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32> {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 4, preferred_expand = "e2b"}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    return %out : !pto.vmi.vreg<64xf32>
  }
}

// CHECK: failed to legalize operation 'pto.vmi.group_broadcast_load'
// CHECK: preferred_expand = "e2b"
