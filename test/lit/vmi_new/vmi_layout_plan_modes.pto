// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --vmi-layout-mode=legacy %s -o - | FileCheck %s --check-prefix=LEGACY
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --vmi-layout-mode=auto --dump-vmi-layout-plan %t.plan %s -o - | FileCheck %s --check-prefix=AUTO
// RUN: FileCheck %s --check-prefix=PLAN --input-file=%t.plan
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --vmi-layout-mode=override --vmi-layout-plan-file=%S/Inputs/vmi_layout_plan_vselr.plan %s -o - | FileCheck %s --check-prefix=OVERRIDE
// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --vmi-layout-mode=override --vmi-layout-plan-file=%S/Inputs/vmi_layout_plan_bad_g.plan %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=BADG
// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --vmi-layout-mode=override %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=NEEDFILE

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @qvmi01_scale_expand(%src_gm: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c0_i64 = arith.constant 0 : i64
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %slots = pto.vmi.vload %ub[%c0], %c1 {group = 8}
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
      pto.vmi.vstore %slots, %ub[%c0], %c1 {group = 8}
          : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
      %expanded = pto.vmi.vbrc %slots {group = 8}
          : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<64xf32>
      pto.vmi.vstore %expanded, %ub[%c0]
          : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
    }
    return
  }
}

// LEGACY: pto.vselr
// LEGACY-NOT: dist = "E2B_B32"

// AUTO: dist = "E2B_B32"
// AUTO-NOT: pto.vselr

// PLAN: preferred_expand: e2b
// PLAN: MaterializeBoundary
// PLAN: Expand(8,e2b)

// OVERRIDE: pto.vselr
// OVERRIDE-NOT: dist = "E2B_B32"

// BADG: Compact/Expand(G=16) does not match VMI groups {8}

// NEEDFILE: --vmi-layout-mode=override requires --vmi-layout-plan-file
