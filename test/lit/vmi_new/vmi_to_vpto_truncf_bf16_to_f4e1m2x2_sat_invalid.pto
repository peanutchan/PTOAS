// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s

// bf16 -> f4E1M2x2 contract has requiresSat=false; if the user explicitly
// requests SAT, resolveSat forwards "SAT" and the physical pto.vcvt verifier
// must reject the resulting op.

module {
  func.func @vmi_to_vpto_truncf_bf16_to_f4e1m2x2_sat_invalid(
      %wide: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<deinterleaved = 4>>)
      -> !pto.vreg<256x!pto.f4E1M2x2> {
    %packed = pto.vmi.vcvt %wide {saturate = "SAT"}
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<deinterleaved = 4>>
        -> !pto.vmi.vreg<128x!pto.f4E1M2x2, #pto.vmi.layout<contiguous>>
    %p = "pto.vmi.unpack"(%packed)
        : (!pto.vmi.vreg<128x!pto.f4E1M2x2, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<256x!pto.f4E1M2x2>
    return %p : !pto.vreg<256x!pto.f4E1M2x2>
  }
}

// CHECK: 'pto.vcvt' op sat attr is not valid for this vcvt type pair