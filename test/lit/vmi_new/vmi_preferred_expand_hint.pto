// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

// Phase 3: preferred_expand hint selects Expand path (e2b vs vselr).

module {
  func.func @prefer_e2b_f32(
      %src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.vload %src[%off], %c1
        {dist_mode = "brc", group = 8, preferred_expand = "e2b"}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %out : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @prefer_vselr_f32(
      %src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.vload %src[%off], %c1
        {dist_mode = "brc", group = 8, preferred_expand = "vselr"}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %out : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @prefer_brc_g1_f32(
      %src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    // G=1 full VL: BRC direct path (not E2B which needs G=8).
    %out = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 1, preferred_expand = "brc"}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %out : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }
}

// CHECK-LABEL: func.func @prefer_e2b_f32
// CHECK: pto.vlds {{.*}} {dist = "E2B_B32"}
// CHECK-NOT: pto.vselr

// CHECK-LABEL: func.func @prefer_vselr_f32
// CHECK: pto.vselr
// CHECK-NOT: dist = "E2B_B32"

// CHECK-LABEL: func.func @prefer_brc_g1_f32
// CHECK: pto.vlds {{.*}} {dist = "BRC_B32"}
