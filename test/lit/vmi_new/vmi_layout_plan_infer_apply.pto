// RUN: pto-test-opt %s -vmi-infer-layout-plan | FileCheck %s --check-prefix=INFER
// RUN: pto-test-opt %s -vmi-infer-layout-plan -vmi-apply-layout-plan | FileCheck %s --check-prefix=APPLY

// Soft-cost auto: KeepLive + Expand(vbrc) beats Materialize@vf + e2b.

module {
  func.func @compact_store_group_vbrc(
      %slots: !pto.vmi.vreg<8xf32>,
      %dst: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32> {
    %c1 = arith.constant 1 : index
    pto.vmi.vstore %slots, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    %out = pto.vmi.vbrc %slots {group = 8}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<64xf32>
    return %out : !pto.vmi.vreg<64xf32>
  }
}

// INFER: pto.vmi.layout_plan = {
// INFER-DAG: preferred_expand = "vbrc"
// INFER-DAG: source = "auto"
// INFER-DAG: residency = "keeplive"
// INFER-DAG: morphs = ["Compact(8)", "Expand(8,vbrc)", "KeepLive"

// APPLY: pto.vmi.preferred_expand = "vbrc"
// APPLY: pto.vmi.vbrc {{.*}}{group = 8{{.*}}preferred_expand = "vbrc"}
// APPLY-NOT: pto.mem_bar "VST_VLD"
